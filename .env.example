# Copie para .env.local (nunca commitar). Em produção, configure na Vercel.

# Público
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL=contato@prumopaisagismo.com.br
# Só dígitos com DDI (ex.: 55419XXXXXXXX). Vazio = botões de WhatsApp somem.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_SOCIAL_LIVE=false
# Razão social + CNPJ (obrigatório no go-live)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Chave de teste do Turnstile (sempre passa) para desenvolvimento
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_WEBMCP_OT_TOKEN=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_GBP_URL=

# Servidor
# Segredo de teste do Turnstile (sempre passa)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Vazio em desenvolvimento = e-mails aparecem no console
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=Prumo Paisagismo <onboarding@resend.dev>
BLOB_READ_WRITE_TOKEN=
INDEXNOW_KEY=
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=

# Só em desenvolvimento: exibe src/content/obras/_exemplo.mdx para validar o layout
PRUMO_SHOW_EXAMPLE_OBRA=false
